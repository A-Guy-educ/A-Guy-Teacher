{
  "name": "a-guy-teacher",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Teacher deployment boundary for A-Guy",
  "license": "BSL-1.1",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vitest.config.ts next.config.ts",
    "format": "prettier --write src tests package.json tsconfig.json next.config.ts vitest.config.ts README.md AGENTS.md .github",
    "format:check": "prettier --check src tests package.json tsconfig.json next.config.ts vitest.config.ts README.md AGENTS.md .github",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@a-guy/api-client": "https://github.com/A-Guy-educ/A-Guy-Shared/releases/download/v0.1.2/a-guy-api-client-0.1.2.tgz",
    "@a-guy/ui": "https://github.com/A-Guy-educ/A-Guy-Shared/releases/download/v0.1.1/a-guy-ui-0.1.1.tgz",
    "next": "15.5.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/eslint-plugin-next": "15.5.9",
    "@types/node": "^22.5.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.5.9",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "^3.4.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^10 || ^11"
  },
  "packageManager": "pnpm@10.33.0"
}
