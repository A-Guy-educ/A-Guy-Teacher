{
  "$schema": "https://raw.githubusercontent.com/aharonyaircohen/Kody-Engine-Lite/main/kody.config.schema.json",
  "quality": {
    "typecheck": "pnpm typecheck",
    "lint": "pnpm lint",
    "format": "pnpm format",
    "testUnit": "pnpm test:unit:coverage"
  },
  "git": {
    "defaultBranch": "dev"
  },
  "github": {
    "owner": "A-Guy-educ",
    "repo": "A-Guy-Web",
    "operators": [
      "aguyaharonyair"
    ]
  },
  "agent": {
    "model": "minimax/MiniMax-M3",
    "reasoningEffort": "high"
  },
  "qa": {
    "fallbackUrl": "https://dev.aguy.co.il"
  },
  "release": {
    "releaseBranch": "main",
    "allowAdminMerge": true,
    "validation": {
      "workflow": "ci.yml",
      "inputs": {
        "release_gate": true
      }
    },
    "versionFiles": [
      "package.json"
    ],
    "productionUrl": "https://www.aguy.co.il",
    "e2eCommand": "npx tsx scripts/release-e2e-gate.ts",
    "timeoutMs": 1800000
  },
  "defaultExecutable": "classify",
  "defaultPrExecutable": "fix",
  "onPullRequest": "preview-build",
  "access": {
    "allowedAssociations": [
      "OWNER",
      "COLLABORATOR",
      "CONTRIBUTOR",
      "FIRST_TIME_CONTRIBUTOR",
      "MEMBER"
    ]
  },
  "company": {
    "activeCapabilities": [
      "capability-call",
      "classify",
      "research",
      "plan",
      "feature",
      "bug",
      "chore",
      "spec",
      "review",
      "fix-ci",
      "ci-health",
      "dev-ci-health",
      "pr-health-triage",
      "redispatch",
      "sync",
      "merge",
      "revert",
      "release-prepare",
      "vercel-production-deploy",
      "release-merge",
      "release-promote",
      "design-review",
      "preview-health",
      "qa",
      "qa-engineer",
      "qa-goal",
      "qa-sweep",
      "qa-verify",
      "quality-watch",
      "ui-review",
      "fix",
      "resolve",
      "build-knowledge-graph",
      "create-knowledge-report",
      "publish-knowledge-system",
      "release-validate",
      "publish-chat-knowledge-tool",
      "build-chat-knowledge-graph",
      "collect-chat-knowledge-evidence"
    ],
    "activeAgents": [
      "ceo",
      "cto",
      "kody",
      "guy-math-teacher",
      "qa",
      "repo-brain",
      "tech-writer",
      "ux-designer"
    ],
    "activeGoals": [
      "daily-web-release-loop",
      "ai-agency-health",
      "ci-health",
      "prs-stay-mergeable",
      "product-quality",
      "agency-observer",
      "agency-operating-loop"
    ],
    "activeWorkflows": [
      "refresh-knowledge-system",
      "web-release"
    ]
  },
  "fly": {
    "previews": {
      "cpus": 2,
      "memoryMb": 2048,
      "ttlDays": 14,
      "builderCpus": 4,
      "builderMemoryMb": 8192,
      "idleSuspend": true,
      "healthCheck": false
    }
  }
}